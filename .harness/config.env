# Design Lens harness configuration (sealed — edit BETWEEN runs, then re-run bootstrap to re-seal)

# ---- engine ----
ENGINE=claude                # claude | codex (codex leg is secondary: documented, not machine-verified)
MODEL_PLAN=opus
MODEL_BUILD=opus             # tip: switch to sonnet after Milestone 1 for cheaper builds

# ---- budgets ----
MAX_PLAN_ITER=8
MAX_BUILD_ITER=100
ITERATION_TIMEOUT_SEC=3600   # watchdog kill per iteration
STUCK_THRESHOLD=4            # consecutive iterations without a new commit => STUCK
MAX_COST_USD=400             # summed from stream-json result events (claude engine only)
MIN_PLAN_TASKS=15            # plan lint: minimum task count

# ---- git ----
RALPH_BRANCH=ralph
PUSH=0                       # 1 = git push each iteration (requires a configured remote)

# ---- pins ----
PLAYWRIGHT_VERSION=1.61.1    # keep in sync with plugin/cli package.json and plugin/scripts/bootstrap.sh

# ---- sealed fixture (these ports are baked into fixture/style.css — do NOT change) ----
FIXTURE_PORT=4630
FIXTURE_ALT_PORT=4631
