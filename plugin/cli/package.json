{
  "name": "design-lens",
  "version": "0.1.0",
  "type": "module",
  "description": "Design Lens CLI engine — clone a reference site into an editable local mirror.",
  "license": "MIT",
  "author": { "name": "mojomoth" },
  "homepage": "https://github.com/mojomoth/design-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojomoth/design-lens.git",
    "directory": "plugin/cli"
  },
  "keywords": ["design", "frontend", "clone", "playwright", "reference", "claude-code", "codex"],
  "bin": {
    "design-lens": "dist/design-lens.cjs"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "build": "tsup",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/culori": "^4.0.1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20.11.0",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "2.18.1",
    "@percy/dom": "^1.32",
    "@projectwallace/css-analyzer": "^9.9.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "js-beautify": "^2.0.3",
    "playwright": "1.61.1"
  }
}
